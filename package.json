{
  "name": "accountable-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server + Claude Code skills for Accountable (web.accountable.eu) bookkeeping: expenses, bank reconciliation, invoice fetching, Camoufox browser sessions.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "accountable-mcp": "dist/index.js"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "login": "node dist/index.js login",
    "login:accountable": "node dist/index.js browser-login accountable",
    "login:gmail": "node dist/index.js gmail-login",
    "login:aliexpress": "node dist/index.js browser-login aliexpress"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "camofox-browser": "^2.4.8",
    "pdf-lib": "^1.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "accountable",
    "bookkeeping",
    "vat",
    "invoices",
    "camoufox",
    "claude-code"
  ],
  "files": [
    "dist",
    "scripts",
    ".claude",
    ".mcp.json",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/secthings-eu/accountable-mcp.git"
  },
  "homepage": "https://secthings.io",
  "author": "Secthings SRL <julian@secthings.io> (https://secthings.io)"
}
